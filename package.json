{
  "name": "design-system-tokens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Design tokens and React component library from Figma",
  "scripts": {
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs && node scripts/build-typography-modes.mjs && node scripts/build-line-height-modes.mjs && node scripts/build-text-styles.mjs && node scripts/build-segments.mjs",
    "icons:import": "node scripts/import-figma-icons.mjs",
    "dev": "vite",
    "build": "npm run tokens:build && vite build",
    "preview": "vite preview",
    "prestorybook": "npm run tokens:build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run tokens:build && storybook build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@tokens-studio/sd-transforms": "^2.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "playwright": "^1.60.0",
    "storybook": "^10.4.0",
    "style-dictionary": "^5.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.6"
  }
}
